# Application
NODE_ENV=production
PORT=3001
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY=1

# Security (generate a random >= 32 character secret before running in production)
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# SQLite storage path inside container
DB_PATH=/app/data/fixcraft.db

# PostgreSQL service connection (Docker Compose service name: db)
PGHOST=db
PGPORT=5432
PGUSER=fixcraft
PGPASSWORD=replace_with_a_strong_db_password
PGDATABASE=fixcraft
POSTGRES_USER=fixcraft
POSTGRES_PASSWORD=replace_with_a_strong_db_password
POSTGRES_DB=fixcraft

# Container image tag (used for deploy and rollback without rebuilding)
IMAGE_TAG=1.0.0
